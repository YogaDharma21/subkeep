{
  "name": "subkeep",
  "version": "0.0.1",
  "private": true,
  "description": "SubKeep - Sleek & modern subscription tracker",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --prefix apps/website",
    "dev:desktop": "npm run dev --prefix apps/desktop",
    "build": "npm run build --prefix apps/website",
    "build:desktop": "npm run build --prefix apps/desktop",
    "start": "npm run start --prefix apps/website",
    "lint": "npm run lint --prefix apps/website",
    "typecheck": "npm run typecheck --prefix apps/website",
    "typecheck:desktop": "npm run typecheck --prefix apps/desktop",
    "format": "npm run format --prefix apps/website"
  },
  "keywords": [
    "subscription-tracker",
    "finance",
    "nextjs",
    "convex",
    "clerk",
    "tailwind"
  ],
  "author": "Yoga Dharma",
  "license": "MIT"
}
